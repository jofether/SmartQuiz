# SmartQuiz environment variables
# Copy this file to .env (not committed) and fill in secrets.

# Firebase
FIREBASE_API_KEY=your-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=smartquiz-dev
FIREBASE_STORAGE_BUCKET=smartquiz-dev.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:abc123
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# AWS / Backend
S3_UPLOAD_BUCKET=smartquiz-input-dev
QUIZ_GENERATION_ENDPOINT=https://genai.yourdomain.com/v1/quizzes
QUIZ_GENERATION_API_KEY=replace-me
FIRESTORE_PROJECT_ID=smartquiz-dev
GOOGLE_APPLICATION_CREDENTIALS=/opt/google/key.json
